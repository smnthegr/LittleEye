# Copy to .env.local. Use a dedicated, restricted Search API key for local preview.
# EXPO_PUBLIC_ values are included in the app bundle; use an authenticated proxy
# before production deployment. Never put account passwords here or paste keys in chat.
# When set, TomTom replaces Photon suggestions. Restart Expo after changing it.
EXPO_PUBLIC_TOMTOM_API_KEY=
# Fallback while the TomTom account/key is not configured:
EXPO_PUBLIC_PHOTON_URL=https://photon.komoot.io/api/
